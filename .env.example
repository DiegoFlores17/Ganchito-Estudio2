DATABASE_URL=
ZECAT_API_TOKEN=
ZECAT_API_URL=

# CDO Promocionales / Stocksur — segundo proveedor.
# Ojo: el header es X-Auth-Token, no Bearer (a diferencia de Zecat).
CDO_API_TOKEN=
CDO_API_URL=

# Auth.js — panel /admin
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
INITIAL_SUPER_ADMIN_EMAIL=

# Protege /api/cron/usd-rate. En Vercel, cuando esta variable existe, la
# plataforma manda sola el header `Authorization: Bearer ${CRON_SECRET}` al
# disparar el cron. Si falta, el endpoint devuelve 503 y no actualiza nada:
# queda cerrado a proposito, en vez de abierto a quien adivine la URL.
#
# En local NO hay cron que lo dispare; sirve solo para probar el endpoint a
# mano. Usar un valor DISTINTO al de produccion. Generar con:
#   openssl rand -hex 32
CRON_SECRET=

# Resend: mails transaccionales (aviso de cotizacion nueva + alertas del
# sync). El dominio de envio es un SUBdominio verificado
# (send.ganchitoestudio.com), aparte del correo humano de Workspace, para
# que la reputacion del transaccional no contamine al corporativo.
#
# SIN esta clave la app NO manda mails: loguea el mail entero que habria
# mandado. Es a proposito — permite verificar contenido en local sin quemar
# cuota ni mandar correos de prueba.
RESEND_API_KEY=

# Destino de las ALERTAS TECNICAS del sync (umbral frenado, corrida
# fallida). Distinto de SiteConfig.contactEmail, que es el destino de los
# avisos de COTIZACION y lo edita el cliente desde el panel: uno es
# mantenimiento, el otro es negocio.
ALERT_EMAIL=

# URL publica del sitio, con protocolo y sin barra final. Se usa para el
# link "Ver detalle" del mensaje de WhatsApp y para el metadataBase de Next.
# En produccion es el dominio propio, NO el .vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
