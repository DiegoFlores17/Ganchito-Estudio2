# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# URL de produccion (Neon): explicita aunque .env* ya la cubra, para que
# nadie la saque de la lista al tocar la regla general.
.env.neon

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archivos subidos por clientes (storage local de desarrollo, ver PENDIENTES.md)
/uploads/

# configuracion local de Claude Code (sesion/permisos de esta maquina, no del proyecto)
/.claude/

# snapshots de datos de proveedor antes de una reimportacion (megabytes de JSON,
# utiles como red de seguridad en la maquina, no como historia del repo)
/backups/

# estado local de la herramienta de skills (registro regenerado en cada maquina)
/.atl/
