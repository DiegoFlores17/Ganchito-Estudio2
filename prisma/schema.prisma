// ============================================================================
//  schema.prisma  —  Catálogo unificado multi-proveedor (Ganchito Estudio)
// ----------------------------------------------------------------------------
//  Idea central: TU base es la fuente de verdad. Zecat, la carga manual y
//  futuros proveedores son solo "orígenes" que alimentan la misma tabla de
//  productos. El campo `origen` distingue de dónde vino cada uno.
//
//  Precios: se guarda SIEMPRE el costo (lo que trae la API de Zecat). El precio
//  de venta se calcula = costo * (1 + margen). El IVA va aparte, nunca embebido
//  en el precio base (igual que la página actual: "$ X + IVA").
//
//  Flujo comercial inicial: catálogo + cotización (Quote), no pago online.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
//  ENUMS
// ----------------------------------------------------------------------------

/// De dónde salió el producto. Este campo es el corazón de la migración:
/// permite que Zecat, la carga manual y otros proveedores convivan igual.
enum ProductOrigin {
  ZECAT
  /// CDO Promocionales / Stocksur. Sus precios vienen en USD y se convierten
  /// al leer con PricingConfig.usdRate.
  CDO
  MANUAL
  OTHER
}

/// Moneda del costo que devuelve el proveedor. Zecat puede mandar ARS o USD
/// (campo `currency` en la API), así que hay que normalizarlo.
enum Currency {
  ARS
  USD
}

/// Estado de una cotización a lo largo de su ciclo de vida.
enum QuoteStatus {
  DRAFT       // el cliente la está armando
  SUBMITTED   // el cliente la envió, esperando respuesta
  QUOTED      // Ganchito respondió con precio final
  ACCEPTED
  REJECTED
  EXPIRED
}

/// SUPER_ADMIN: configuración de negocio (margen, IVA, gestión de equipo).
/// ADMIN: operación del día a día (cotizaciones). No ve equipo ni configuración.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// ----------------------------------------------------------------------------
//  PANEL DE ADMINISTRACIÓN
//  Los clientes NO tienen cuenta. La única identidad del sistema es la del
//  equipo de Ganchito, autenticado con Google (Auth.js) y autorizado acá.
//  El primer SUPER_ADMIN se crea por bootstrap (ver src/lib/admin-auth.ts),
//  no hay seed manual.
// ----------------------------------------------------------------------------

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())

  @@map("admin_users")
}

// ----------------------------------------------------------------------------
//  CONFIGURACIÓN GLOBAL DE PRECIOS
//  Una sola fila. El margen y el IVA viven acá para poder cambiarlos sin tocar
//  código ni re-sincronizar el catálogo.
// ----------------------------------------------------------------------------

model PricingConfig {
  id                  Int      @id @default(1)
  /// Margen global sobre el costo, en porcentaje (no fracción). Ej: 45 = costo * 1.45.
  /// Editable desde el panel admin. Preparado para eventualmente admitir un
  /// margen por producto, pero eso no está implementado todavía.
  defaultMarginPercent Decimal @default(45) @db.Decimal(5, 2)
  /// Alícuota de IVA a mostrar/calcular aparte, como fracción. Ej: 0.21 = 21%.
  vatRate             Decimal  @default(0.21) @db.Decimal(6, 4)

  /// Cotización del dólar para pasar a pesos los costos que vienen en USD
  /// (hoy: CDO Promocionales). Editable desde el panel, igual que el margen.
  ///
  /// Es MANUAL y no sale de una API de dólar a propósito: el valor que usa CDO
  /// (su web muestra "Cotización Dólar: $1510") es una decisión comercial de
  /// ellos, no el dólar de mercado. Una API externa daría el oficial o el blue
  /// y desalinearía los precios contra lo que CDO factura.
  ///
  /// La conversión se hace AL LEER, no al sincronizar: así mover este número
  /// actualiza todo el catálogo al instante, sin re-sincronizar ~950 productos.
  /// Mismo criterio que defaultMarginPercent.
  ///
  /// Pendiente: se le preguntó a CDO si tienen endpoint de cotización sin
  /// documentar. Si aparece, esto pasa a alimentarse solo.
  usdRate             Decimal  @default(1510) @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt

  // Garantiza que exista una sola fila de config (id siempre = 1).
  @@map("pricing_config")
}

// ----------------------------------------------------------------------------
//  CATEGORÍAS (mapea a "families" de Zecat, pero sirve para todos los orígenes)
// ----------------------------------------------------------------------------

model Category {
  id            String    @id @default(cuid())
  /// id de la familia en Zecat (para hacer upsert y no duplicar). Null si es
  /// una categoría propia creada a mano.
  zecatFamilyId String?   @unique
  /// id de la categoría en CDO. Mismo rol que zecatFamilyId, para su conector.
  cdoCategoryId String?   @unique
  name          String
  slug          String    @unique
  description   String?
  iconUrl       String?
  /// Para ordenar/destacar en tu tienda, independiente de Zecat.
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  /// Si la categoría se ofrece como filtro en el catálogo público.
  ///
  /// Los conectores importan TODAS las categorías del proveedor, incluidas
  /// campañas temporales ("2026 Agro", "Día de la Madre") y duplicados de
  /// oferta ("70%OFF Bolsos y Mochilas"). Filtrarlas desde el conector por
  /// nombre sería adivinar, así que la decisión vive acá y se toma desde el
  /// panel.
  ///
  /// OJO — apagar esto NO oculta ningún producto: los productos de una
  /// categoría oculta siguen apareciendo en el catálogo y en la búsqueda.
  /// Lo único que se saca es la categoría como opción de filtro. Un link
  /// directo a /catalogo?categoria={slug} sigue funcionando.
  ///
  /// Default true: una categoría nueva del proveedor aparece hasta que
  /// alguien decida lo contrario. Al revés, un proveedor nuevo entraría
  /// entero invisible y nadie se enteraría.
  visible       Boolean   @default(true)

  products      Product[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("categories")
}

// ----------------------------------------------------------------------------
//  PRODUCTO  (mapea a "generic_product" de Zecat)
//  El precio de venta NO se guarda: se calcula desde costPrice + margen al vuelo
//  o en una capa de servicio. Se guarda solo el costo para no perder el dato
//  base cuando cambie el margen.
// ----------------------------------------------------------------------------

model Product {
  id                String        @id @default(cuid())
  origin            ProductOrigin @default(ZECAT)

  /// id del generic_product en Zecat. Null para productos manuales.
  /// Es la clave para el upsert del conector (no duplicar en cada sync).
  zecatId           String?       @unique
  /// external_id de Zecat (los kits no lo tienen, por eso es opcional).
  externalId        String?

  /// id del producto en CDO. Clave del upsert de ese conector.
  ///
  /// Columna propia en vez de reusar `externalId`: darle dos significados
  /// segun el origen es como empiezan los bugs raros. Y NO se usa el `code`
  /// de CDO, que trae basura — hay uno cuyo code es literalmente
  /// "25% de descuento!!!!!".
  ///
  /// Con un tercer proveedor esto se generaliza a externalId + source; con
  /// dos, una columna paralela sale mas barata que el refactor.
  cdoId             String?       @unique

  name              String
  description       String?       @db.Text

  /// El COSTO vive en ProductVariant, no acá: hay proveedores con precios
  /// distintos por variante (ver el comentario de ProductVariant.costPrice).
  /// La moneda sí es del producto: todas sus variantes comparten una.
  currency          Currency      @default(ARS)

  /// Cantidad mínima para personalizar sin costo extra (minimum_order_quantity).
  /// Por debajo de esto, Zecat aplica un recargo ("bonificación del costo").
  minOrderQuantity  Int?

  /// Dimensiones (objeto `dimensions` de la API). En cm y gramos.
  heightCm          Decimal?      @db.Decimal(8, 2)
  widthCm           Decimal?      @db.Decimal(8, 2)
  lengthCm          Decimal?      @db.Decimal(8, 2)
  weightG           Decimal?      @db.Decimal(10, 2)

  /// Espejo de `published`/`active` de Zecat. Importás solo lo publicado, pero
  /// guardás el flag por si un producto se despublica entre syncs.
  /// Para productos MANUAL, "pausar" desde el panel es poner esto en false.
  active            Boolean       @default(true)

  /// Baja lógica de productos manuales. Null = vigente.
  ///
  /// No se reusa `active` para esto: `active` significa "pausado", un estado
  /// reversible que el admin ve y puede volver a prender. Si eliminar fuera
  /// `active = false`, "Pausar" y "Eliminar" serían el mismo botón con dos
  /// nombres, y un producto eliminado reaparecería en la grilla como si solo
  /// estuviera en pausa.
  ///
  /// Es baja lógica y no borrado real porque `QuoteItem` referencia al
  /// producto por FK con ON DELETE RESTRICT, y el detalle de cotización lee
  /// `item.product.name` (el nombre NO se copia al cotizar, solo el precio se
  /// congela). Borrarlo de verdad rompería las cotizaciones históricas.
  deletedAt         DateTime?

  /// Proveedor en texto libre, SOLO para productos origin=MANUAL cargados a
  /// mano desde el panel. No tiene relación con el modelo Supplier (esa es
  /// la reserva para el sistema multi-proveedor automatizado futuro).
  supplierName      String?

  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])

  variants          ProductVariant[]
  images            ProductImage[]
  printingAreas     PrintingArea[]
  printingTypes     ProductPrintingType[]
  attributes        ProductAttribute[]
  quoteItems        QuoteItem[]

  /// Marca de la última vez que el conector actualizó este producto.
  /// Útil para detectar productos "huérfanos" (que Zecat ya no devuelve).
  lastSyncedAt      DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([origin])
  @@index([categoryId])
  @@map("products")
}

// ----------------------------------------------------------------------------
//  VARIANTES  (color / talle)  — mapea a "products"/"variants" de la API
//  Cada variante tiene su propio SKU y su propio stock.
// ----------------------------------------------------------------------------

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// SKU de la variante (campo `sku`). Único.
  sku            String   @unique
  colorName      String?  // elementDescription1 / attribute "Color"
  /// Codigo hex del color, cuando el proveedor lo manda (CDO sí, Zecat no).
  colorHex       String?
  sizeName       String?  // elementDescription2 / talle
  materialName   String?  // elementDescription3 / material

  /// Stock BRUTO y RESERVADO tal cual la API. El stock real que mostrás en la
  /// tienda es (stock - reservedStock). No muestres el bruto.
  ///
  /// OJO con CDO: su `stock_available` YA viene neto, no es el par de Zecat.
  /// El mapeo correcto es stock = stock_existent y
  /// reservedStock = stock_existent - stock_available, para que el neto dé
  /// `stock_available`. Mapear available a reservedStock daría lo RESERVADO.
  stock          Int      @default(0)
  reservedStock  Int      @default(0)

  /// COSTO de ESTA variante, en la moneda del producto (ver Product.currency).
  ///
  /// Vive acá y no en Product porque hay proveedores con precios distintos por
  /// variante: en CDO, el producto OCEAN tiene variantes a 194.97 y a 205.23.
  /// Un solo precio a nivel producto obligaría a elegir uno y mostrar un
  /// número que no le corresponde a la variante que el cliente elige.
  ///
  /// Zecat repite el mismo valor en todas las variantes de un producto, que es
  /// correcto: ahí el costo efectivamente es único.
  ///
  /// El precio de VENTA no se guarda: se calcula al leer, con el margen y la
  /// cotización de PricingConfig. Ver la nota de usdRate.
  costPrice      Decimal  @db.Decimal(12, 2)

  active         Boolean  @default(true)

  images         ProductImage[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// ----------------------------------------------------------------------------
//  IMÁGENES  — URLs al S3 de Zecat (no se editan; son la foto del producto).
//  Para productos manuales, acá van tus propias URLs.
// ----------------------------------------------------------------------------

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Si la imagen es específica de una variante (color), se linkea acá.
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  url        String
  isMain     Boolean         @default(false)
  sortOrder  Int             @default(0)

  @@index([productId])
  @@map("product_images")
}

// ----------------------------------------------------------------------------
//  PERSONALIZACIÓN  — áreas y técnicas de impresión (printing_areas / _types)
//  No editás la foto: guardás la INFORMACIÓN de qué se puede imprimir y dónde.
// ----------------------------------------------------------------------------

model PrintingArea {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  zecatAreaId String?  // id del área en Zecat
  name        String   // ej: "FRENTE"
  heightCm    Decimal? @db.Decimal(8, 2)
  widthCm     Decimal? @db.Decimal(8, 2)

  @@index([productId])
  @@map("printing_areas")
}

model ProductPrintingType {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  zecatTypeId   String?
  name          String   // ej: "Transfer digital", "Serigrafía", "Bordado"

  @@index([productId])
  @@map("product_printing_types")
}

/// Atributos del producto que NO son técnicas de impresión: certificaciones y
/// características ("RECICLABLE", "BPA FREE", "Apto microondas", "Caja de
/// regalo").
///
/// Existe por CDO: su campo `icons` mezcla las dos cosas en una sola lista —
/// Serigrafía y Bordado conviven con RECICLABLE y REUTILIZABLE. Las técnicas
/// van a ProductPrintingType; lo demás cae acá en vez de perderse.
///
/// La separación se hace con una lista explícita de ids en el conector, no
/// adivinando por el texto: si CDO agrega un icono nuevo, cae en el default y
/// queda logueado para revisarlo, nunca clasificado mal en silencio.
model ProductAttribute {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// id del icono en el proveedor, para poder rastrear de dónde salió.
  externalId  String?
  name        String
  iconUrl     String?

  @@index([productId])
  @@map("product_attributes")
}

// ----------------------------------------------------------------------------
//  COTIZACIONES  (en vez de órdenes de pago, para el flujo con logo)
// ----------------------------------------------------------------------------

model Quote {
  id           String       @id @default(cuid())
  status       QuoteStatus  @default(DRAFT)

  // Datos del cliente que pide el presupuesto.
  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?

  /// URL del logo/arte que sube el cliente (a tu storage). Opcional en DRAFT.
  logoUrl       String?
  notes         String?     @db.Text

  items         QuoteItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId      String
  product        Product  @relation(fields: [productId], references: [id])

  /// Variante elegida (color/talle). String libre para no romper si se borra.
  variantSku     String?
  quantity       Int

  /// Técnica de impresión elegida por el cliente para este ítem.
  printingType   String?

  /// Precio de venta unitario CONGELADO al momento de cotizar (costo+margen,
  /// sin IVA). Se guarda para que la cotización no cambie si después movés el
  /// margen o Zecat cambia el costo.
  unitPrice      Decimal  @db.Decimal(12, 2)

  @@index([quoteId])
  @@map("quote_items")
}

// ----------------------------------------------------------------------------
//  PROVEEDORES — semilla para el sistema multi-proveedor futuro.
//  TODAVIA NO está conectada a nada (ni a Product ni a ningún conector).
//  Solo reserva la estructura para no migrar en caliente el día que haga
//  falta. La lógica de conexión (fetch, normalización, sync) se construye
//  recién cuando exista un segundo proveedor real con API, siguiendo el
//  patrón de src/lib/zecat/. No usar esta tabla para nada hasta ese momento.
// ----------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  apiKey    String?
  apiUrl    String?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}
